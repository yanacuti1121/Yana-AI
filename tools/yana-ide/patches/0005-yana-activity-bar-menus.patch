+function getEffectiveLocale(configService: IConfigurationService): string {
+	const inspect = configService.inspect<string>('yana.language');
+	if (inspect?.userValue) {
+		return inspect.userValue;
+	}
+	const lang = Language.value();
+	if (lang && lang.toLowerCase().split('-')[0] !== 'en') {
+		return lang;
+	}
+	return inspect?.defaultValue || configService.getValue<string>('yana.language') || lang || 'en';
+}
