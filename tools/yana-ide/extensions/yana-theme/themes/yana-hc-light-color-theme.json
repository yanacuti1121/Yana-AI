{
	"$schema": "vscode://schemas/color-theme",
	"name": "Yana High Contrast Light",
	"type": "hcLight",
	"colors": {
		"focusBorder": "#075985",
		"contrastActiveBorder": "#075985",
		"contrastBorder": "#075985",
		"activityBar.activeBorder": "#075985",
		"tab.activeBorderTop": "#075985",
		"button.background": "#075985",
		"textLink.foreground": "#075985"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6f747f",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#C2410C"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#15803D"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language"
			],
			"settings": {
				"foreground": "#B45309"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#A16207"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#0E7490"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#0F172A"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#0369A1"
			}
		},
		{
			"scope": [
				"variable.language.this",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#C2410C"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#616672"
			}
		},
		{
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#0369A1",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#DC2626"
			}
		}
	]
}
