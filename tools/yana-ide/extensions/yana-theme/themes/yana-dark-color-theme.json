	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#928f8b",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#f19266"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#41dca5"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language"
			],
			"settings": {
				"foreground": "#efa831"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#f4d660"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#63ede6"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#eae7e5"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#c1d4fd"
			}
		},
		{
			"scope": [
				"variable.language.this",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#f19266"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace"
			],
			"settings": {
				"foreground": "#b4b0ad"
			}
		},
		{
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#76a1ff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#f05653"
			}
		}
	]
}
