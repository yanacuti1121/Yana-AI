{
  "name": "yana-desktop",
  "version": "1.3.2",
  "description": "Yana AI — desktop shell",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "Vũ Văn Tâm",
    "email": "phamlongh230@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanacuti1121/Yana-AI"
  },
  "scripts": {
    "start": "electron .",
    "stage:runtime": "node scripts/stage-runtime.js",
    "test": "node _test_runtime_paths.js",
    "build:linux": "electron-builder --linux",
    "build:mac":   "electron-builder --mac",
    "build:win":   "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron":         "31.3.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "yanacuti1121",
        "repo": "Yana-AI"
      }
    ],
    "appId": "com.yana-ai.yana",
    "productName": "Yana AI",
    "artifactName": "Yana-AI-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Vũ Văn Tâm",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime-paths.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "../yana-web",
        "to": "Resources/server",
        "filter": ["**/*", "!node_modules/**", "!dist/**", "!.yana/**", "!desktop-old/**", "!desktop-src/**"]
      },
      {
        "from": "../../MANIFEST.json",
        "to": "Resources/MANIFEST.json"
      },
      {
        "from": "../../scripts/yana-rt-wrapper.js",
        "to": "Resources/scripts/yana-rt-wrapper.js"
      },
      {
        "from": "../../target/desktop-runtime/bin",
        "to": "Resources/bin",
        "filter": ["**/*"]
      },
      {
        "from": "../../target/desktop-runtime/pty-bridge",
        "to": "Resources/pty-bridge",
        "filter": ["**/*"]
      },
      {
        "from": "../../core",
        "to": "Resources/core",
        "filter": ["agents/**", "skills/**", "config/**", "memory/**"]
      },
      {
        "from": "../../memory",
        "to": "Resources/memory",
        "filter": ["L1_atomic/**"]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@31.3.0": true
  }
}
