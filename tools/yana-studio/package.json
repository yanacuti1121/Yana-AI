{
  "name": "yana-studio",
  "productName": "Yana Studio",
  "version": "1.5.4",
  "description": "Yana Studio — AI coding workspace",
  "homepage": "https://yana.vutam.link",
  "author": {
    "name": "Vũ Văn Tâm",
    "email": "phamlongh230@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanacuti1121/Yana-AI"
  },
  "private": true,
  "type": "module",
  "main": "host/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "write:secrets": "node scripts/write-secrets.cjs",
    "start": "npm run write:secrets && npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:electron": "electron test/smoke.cjs",
    "test:ui": "node test/ui.mjs",
    "stage:runtime": "node scripts/stage-runtime.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "format": "prettier --write host renderer test scripts *.json *.ts *.html",
    "format:check": "prettier --check host renderer test scripts *.json *.ts *.html",
    "dist:mac": "npm run write:secrets && npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run write:secrets && npm run build && electron-builder --win --x64",
    "dist:win-arm64": "npm run write:secrets && npm run build && electron-builder --win --arm64",
    "dist:linux": "npm run write:secrets && npm run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.yana-ai.studio",
    "productName": "Yana Studio",
    "artifactName": "Yana-Studio-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Vũ Văn Tâm",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "host/**/*.cjs",
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "yana-rt",
          "yana-rt.exe",
          "manifest.json"
        ]
      },
      {
        "from": "../../COMMANDS.md",
        "to": "COMMANDS.md"
      },
      {
        "from": "host/integrations/secrets.local.cjs",
        "to": "secrets.local.cjs"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "afterSign": "scripts/after-sign-mac.cjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.12",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
