{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yana-ai.dev/contracts/ui-preferences.schema.json",
  "title": "Yana UI Preferences",
  "description": "Presentation-only preferences owned by the first-party UI. These values may change rendering and interaction ergonomics, but never runtime roots, capability grants, approvals, transport, feature rollout, provider credentials or execution policy.",
  "$comment": "During migration, appearance fields map to the same-named flat keys in the existing yana.tweaks localStorage object. brandBlue + brandPink + brandGreen must total 100; the x-yana-invariant below is enforced by UI normalization and contract tests because standard JSON Schema cannot express arithmetic sums.",
  "type": "object",
  "required": ["schemaVersion", "owner"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "owner": { "const": "yana-ui" },
    "appearance": { "$ref": "#/$defs/appearance" },
    "interaction": { "$ref": "#/$defs/interaction" },
    "layout": { "$ref": "#/$defs/layout" },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "notifications": { "$ref": "#/$defs/notifications" }
  },
  "additionalProperties": false,
  "$defs": {
    "appearance": {
      "type": "object",
      "properties": {
        "theme": { "type": "string", "minLength": 1, "maxLength": 80 },
        "accent": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^(?:#[0-9A-Fa-f]{6})?$"
        },
        "brandBlue": { "type": "integer", "minimum": 0, "maximum": 100 },
        "brandPink": { "type": "integer", "minimum": 0, "maximum": 100 },
        "brandGreen": { "type": "integer", "minimum": 0, "maximum": 100 },
        "glowIntensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "fontScale": {
          "type": "integer",
          "minimum": 90,
          "maximum": 125,
          "description": "Interface scale percentage, matching yana.tweaks."
        },
        "surfaceOpacity": { "type": "integer", "minimum": 70, "maximum": 100 },
        "motifVisibility": { "enum": ["Off", "Subtle", "Visible"] },
        "layout": { "enum": ["Compact", "Regular", "Spacious"] },
        "reduceMotion": { "type": "boolean" },
        "contrastBoost": { "type": "boolean" },
        "chatFont": { "enum": ["System", "Be Vietnam", "Mono"] },
        "showAgents": { "type": "boolean" },
        "showMissions": { "type": "boolean" },
        "showMemory": { "type": "boolean" },
        "showSystem": { "type": "boolean" }
      },
      "x-yana-invariant": {
        "sum": ["brandBlue", "brandPink", "brandGreen"],
        "equals": 100,
        "description": "sanitizePresentationPreferences normalizes the three brand channels to exactly 100 before persistence/application."
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "sendOnEnter": { "type": "boolean" },
        "autoScrollStreaming": { "type": "boolean" },
        "confirmBeforeWindowClose": { "type": "boolean" },
        "copyCodeWithFormatting": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "sidebarCollapsed": { "type": "boolean" },
        "sidebarWidthPx": { "type": "integer", "minimum": 180, "maximum": 640 },
        "detailsPanelCollapsed": { "type": "boolean" },
        "terminalHeightPx": { "type": "integer", "minimum": 120, "maximum": 1200 }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "screenReaderAnnouncements": { "type": "boolean" },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "properties": {
        "desktop": { "type": "boolean" },
        "sound": { "type": "boolean" },
        "showCompletionToast": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
