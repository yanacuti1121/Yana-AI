{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "echo \"shallow=$(git rev-parse --is-shallow-repository) head=$(git rev-parse --short HEAD) parent=$(git rev-parse --short HEAD^ 2>&1)\"; git log --oneline -3; git diff --name-status HEAD^ HEAD | head -5; git diff --quiet HEAD^ HEAD -- docs vercel.json || exit 1",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'" }
      ]
    }
  ]
}
