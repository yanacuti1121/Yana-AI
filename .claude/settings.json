{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"IDEA LOOP AUTO-START: Ngay khi nhận tin nhắn đầu tiên từ người dùng, hãy chạy /idea-loop để kiểm tra trạng thái repo và gợi ý việc làm. Chạy trước khi xử lý yêu cầu của người dùng.\"}}'",
            "statusMessage": "Khởi động Idea Loop..."
          },
          {
            "type": "command",
            "command": "python3 -c \"from headroom import compress; print('[headroom] ready')\" 2>/dev/null || true",
            "statusMessage": "Headroom context compressor..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/precompact-priority-injection.sh bash .claude/hooks/hook-timeout-guard.sh",
            "statusMessage": "Injecting compaction priority requirements..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/giamthi-halt-check.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/guard-destructive.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/guard-blast-radius.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/tool-proxy-enforcer.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/sandbox-wrap.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/deploy-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/supply-chain-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/db-protect.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/api-destruct-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_HOOK_TIMEOUT=150 YANA_GUARDED_HOOK=.claude/hooks/coverage-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/tool-validator.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/prompt-injection-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/token-scope-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/scope-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/freeze-scope.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/infra-review-reminder.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/agent-budget-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/agent-pixel-notify.sh bash .claude/hooks/hook-timeout-guard.sh start"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/log-agent.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/token-budget-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/per-tool-circuit-breaker.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/code-freeze.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/confidence-scorer.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/risk-scorer.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/auto-decompose.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/session-bootstrap.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/truth-gate-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/tool-guardrails-detector.sh bash .claude/hooks/hook-timeout-guard.sh reset"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/context-compress-stop.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/canary-token-guard.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/audit-log.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/budget-sentinel.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/verify-evidence-track.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/tool-guardrails-detector.sh bash .claude/hooks/hook-timeout-guard.sh record"
          },
          {
            "type": "command",
            "command": "bash core/hooks/context-compress-trigger.sh",
            "statusMessage": "Context compression check..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/agent-pixel-notify.sh bash .claude/hooks/hook-timeout-guard.sh stop"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/entry-point-verify-reminder.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/code-quality-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/dependency-safety-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=.claude/hooks/static-analysis-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          },
          {
            "type": "command",
            "command": "YANA_HOOK_TIMEOUT=90 YANA_GUARDED_HOOK=.claude/hooks/test-runner-gate.sh bash .claude/hooks/hook-timeout-guard.sh"
          }
        ]
      }
    ]
  }
}
