{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"IDEA LOOP AUTO-START: Ngay khi nhận tin nhắn đầu tiên từ người dùng, hãy chạy /idea-loop để kiểm tra trạng thái repo và gợi ý việc làm. Chạy trước khi xử lý yêu cầu của người dùng.\"}}'",
            "statusMessage": "Khởi động Idea Loop..."
          },
          {
            "type": "command",
            "command": "python3 -c \"from headroom import compress; print('[headroom] ready')\" 2>/dev/null || true",
            "statusMessage": "Headroom context compressor..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/precompact-priority-injection.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\"",
            "statusMessage": "Injecting compaction priority requirements..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/giamthi-halt-check.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-blast-radius.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool-proxy-enforcer.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/sandbox-wrap.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/deploy-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/supply-chain-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/db-protect.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/api-destruct-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_HOOK_TIMEOUT=150 YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/coverage-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool-validator.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-injection-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/token-scope-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/scope-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/freeze-scope.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/infra-review-reminder.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-budget-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-pixel-notify.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\" start"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/log-agent.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/token-budget-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/per-tool-circuit-breaker.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/code-freeze.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/confidence-scorer.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/risk-scorer.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-decompose.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-bootstrap.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/memory-recall-prompt.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/truth-gate-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool-guardrails-detector.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\" reset"
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-compress-stop.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/canary-token-guard.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/memory-turn-sync-stop.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      }
    ],
 "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-log.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/budget-sentinel.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-evidence-track.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/tool-guardrails-detector.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\" record"
          },
          {
            "type": "command",
            "command": "bash core/hooks/context-compress-trigger.sh",
            "statusMessage": "Context compression check..."
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/token-budget-reset.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-pixel-notify.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\" stop"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/entry-point-verify-reminder.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/code-quality-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/dependency-safety-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/static-analysis-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          },
          {
            "type": "command",
            "command": "YANA_HOOK_TIMEOUT=90 YANA_GUARDED_HOOK=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/test-runner-gate.sh\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-timeout-guard.sh\""
          }
        ]
      }
