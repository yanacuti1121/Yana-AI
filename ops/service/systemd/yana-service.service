[Unit]
Description=Yana AI always-on service (example)
[Service]
Type=simple
WorkingDirectory=/srv/yana-ai-project
ExecStart=/usr/local/bin/yana-rt os service run --dir /srv/yana-ai-project --interval-secs 60
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/yana-ai-project/.yana-ai/os /srv/yana-ai-project/.claude/state

[Install]
WantedBy=default.target
