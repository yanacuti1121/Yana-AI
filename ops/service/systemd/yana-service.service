[Unit]
Description=Yana AI always-on service (example)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yana
Group=yana
WorkingDirectory=/srv/yana-ai-project
ExecStart=/usr/local/bin/yana-rt os service run --dir /srv/yana-ai-project
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/yana-ai-project

[Install]
WantedBy=default.target
