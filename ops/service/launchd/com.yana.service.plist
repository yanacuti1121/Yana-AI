<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yana.service.example</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/yana-rt</string>
    <string>os</string>
    <string>service</string>
    <string>run</string>
    <string>--dir</string>
    <string>/srv/yana-ai-project</string>
    <string>--interval-secs</string>
    <string>60</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/srv/yana-ai-project</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
